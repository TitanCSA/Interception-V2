[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
CatalogFile=InterceptionV2Control.cat
DriverVer=10/30/2026,2.0.0.0
PnpLockdown=1
[Manufacturer]
%Provider%=Models,NTamd64.10.0...16299
[Models.NTamd64.10.0...16299]
%Name%=Control,ROOT\INTERCEPTIONV2
[Control.NT]
CopyFiles=Files
[Control.NT.Services]
AddService=InterceptionV2,2,Service
AddService=InterceptionV2DemoClock,0,TrialClockService
[Service]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\InterceptionV2.sys
[Control.NT.Wdf]
KmdfService=InterceptionV2,Wdf
[Wdf]
