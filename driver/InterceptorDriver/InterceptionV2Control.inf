[DestinationDirs]
Files=13
[Files]
InterceptionV2DemoClock.sys
InterceptionV2.sys
[SourceDisksNames]
1=%Provider%,,,
[SourceDisksFiles]
InterceptionV2DemoClock.sys=1
InterceptionV2.sys=1
[Strings]
Provider="TitanCSA Interception V2"
Name="InterceptionV2 Control Endpoint"
ServiceName="InterceptionV2"

[TrialClockService]
